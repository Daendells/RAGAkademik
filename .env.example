# ================================================
# KONFIGURASI OLLAMA (opsional)
# ================================================
# Ollama berjalan lokal — tidak perlu API key!
#
# Variabel di bawah bersifat opsional.
# Nilai default sudah diset di llm.py.

# Host Ollama (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Model yang digunakan (default: llama3.2)
# Pastikan sudah di-pull: ollama pull llama3.2
# OLLAMA_MODEL=llama3.2
